if __name__ == "__main__":

    # Create first sorted list
    list1 = LinkedList()

    list1.add(1)
    list1.add(2)
    list1.add(4)

    # Create second sorted list
    list2 = LinkedList()

    list2.add(1)
    list2.add(3)
    list2.add(4)

    # Print original lists
    print("List 1:")
    print_list(list1.head)

    print("List 2:")
    print_list(list2.head)

    # Merge the two lists
    merged = list1.mergeTwoLists(list1.head, list2.head)

    # Print merged list
    print("Merged list:")
    print_list(merged)
