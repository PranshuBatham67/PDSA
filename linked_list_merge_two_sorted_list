# Define the node class
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


# Define the linked list class
class LinkedList:
    def __init__(self):
        self.head = None

    # Function to add a node at the end
    def add(self, data):
        new_node = Node(data)

        if not self.head:
            self.head = new_node
        else:
            current = self.head

            while current.next:
                current = current.next

            current.next = new_node

        return new_node

    # Function to create a cycle
    def create_cycle(self, pos):
        if self.head is None:
            return

        current = self.head
        cycle_node = None
        index = 0

        while current.next:
            if index == pos:
                cycle_node = current

            current = current.next
            index += 1

        if cycle_node:
            current.next = cycle_node

    # Function to detect cycle
    def has_cycle(self):
        slow = self.head
        fast = self.head

        while fast and fast.next:
            slow = slow.next
            fast = fast.next.next

            if slow == fast:
                return True

        return False

    # Merge two sorted linked lists
    # Merge Sort algorithm
    def mergeTwoLists(self, list1, list2):

        # Dummy node
        dummy = Node(0)

        current1 = list1
        current2 = list2
        current = dummy # dummy list for merging

        # Compare nodes from both lists
        while current1 is not None and current2 is not None:
            # case1 : when data is less than or equal to
            if current1.data <= current2.data:
                current.next = current1
                current1 = current1.next
            
            # case2: when data is greater
            else:
                current.next = current2
                current2 = current2.next

            current = current.next

        # Attach whatever is remaining
        if current1 is not None:
            current.next = current1
        else:
            current.next = current2

        return dummy.next


# Helper function to print a linked list
def print_list(head):
    current = head

    while current:
        print(current.data, end=" -> ")
        current = current.next

    print("None")


